{
  "openapi": "3.0.3",
  "info": {
    "title": "API Reference | ReDoc",
    "version": "1.0.0",
    "description": "API для керування контактами та аутентифікації користувачів",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "https://nodejs-hw-mongodb-5okd.onrender.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Операції, пов'язані з аутентифікацією користувачів"
    },
    {
      "name": "contacts",
      "description": "Операції з контактами користувачів"
    },
    {
      "name": "general",
      "description": "Загальні ендпоінти"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getRoot",
        "tags": [
          "general"
        ],
        "summary": "Стартова точка API",
        "responses": {
          "200": {
            "$ref": "#/components/responses/success_response"
          },
          "400": {
            "description": "Невірний запит",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Bad request"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "registerUser",
        "tags": [
          "auth"
        ],
        "summary": "Реєстрація користувача",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john.doe@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Користувача успішно зареєстровано",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully registered a user!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/error_response"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "loginUser",
        "summary": "Логін користувача",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john.doe@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Користувач успішно залогінився",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully logged in a user!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/error_response"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "tags": [
          "auth"
        ],
        "summary": "Оновлення сесії (отримання нового access token)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успішне оновлення сесії",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully refreshed a session!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/error_response"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutUser",
        "tags": [
          "auth"
        ],
        "summary": "Вихід з сесії",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Успішний вихід (без контенту)"
          },
          "400": {
            "$ref": "#/components/responses/error_response"
          }
        }
      }
    },
    "/auth/send-reset-email": {
      "post": {
        "operationId": "sendResetEmail",
        "tags": [
          "auth"
        ],
        "summary": "Відправка листа для скидання пароля",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john.doe@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email успішно надіслано"
          },
          "400": {
            "$ref": "#/components/responses/error_response"
          }
        }
      }
    },
    "/auth/reset-pwd": {
      "post": {
        "operationId": "resetPassword",
        "tags": [
          "auth"
        ],
        "summary": "Скидання пароля за токеном",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "password"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "example": "jwt.token.here"
                  },
                  "password": {
                    "type": "string",
                    "example": "newPassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Пароль успішно скинуто"
          },
          "401": {
            "$ref": "#/components/responses/error_response"
          },
          "404": {
            "$ref": "#/components/responses/error_response"
          }
        }
      }
    },
   "/contacts": {
  "get": {
    "operationId": "getContacts",
    "tags": [
      "contacts"
    ],
    "summary": "Отримати всі контакти користувача",
    "parameters": [
      {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer"
        },
        "required": false,
        "description": "Номер сторінки (за замовчуванням 1)"
      },
      {
        "name": "perPage",
        "in": "query",
        "schema": {
          "type": "integer"
        },
        "required": false,
        "description": "Кількість контактів на сторінці (за замовчуванням 10)"
      },
      {
        "name": "sortBy",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "required": false,
        "description": "Поле для сортування (наприклад \"name\")"
      },
      {
        "name": "sortOrder",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "required": false,
        "description": "Порядок сортування (asc або desc)"
      }
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "responses": {
      "200": {
        "description": "Список контактів",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 200
                },
                "message": {
                  "type": "string",
                  "example": "Successfully found contacts!"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Contact"
                      }
                    },
                    "page": {
                      "type": "integer",
                      "example": 1
                    },
                    "perPage": {
                      "type": "integer",
                      "example": 10
                    },
                    "totalItems": {
                      "type": "integer",
                      "example": 50
                    },
                    "totalPages": {
                      "type": "integer",
                      "example": 5
                    },
                    "hasPreviousPage": {
                      "type": "boolean",
                      "example": false
                    },
                    "hasNextPage": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      },
      "401": {
        "$ref": "#/components/responses/error_response"
      }
    }
  },
  "post": {
    "operationId": "createContact",
    "tags": [
      "contacts"
    ],
    "summary": "Створити новий контакт",
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "multipart/form-data": {
          "schema": {
            "type": "object",
            "required": [
              "name",
              "phoneNumber",
              "contactType"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "phoneNumber": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "isFavourite": {
                "type": "boolean"
              },
              "contactType": {
                "type": "string",
                "enum": [
                  "work",
                  "home",
                  "personal"
                ]
              },
              "photo": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Контакт успішно створено",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 201
                },
                "message": {
                  "type": "string",
                  "example": "Successfully created a contact!"
                },
                "data": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          }
        }
      },
      "400": {
        "$ref": "#/components/responses/error_response"
      },
      "401": {
        "$ref": "#/components/responses/error_response"
      }
    }
  }
},
    "/contacts/{contactId}": {
      "parameters": [
        {
          "name": "contactId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Ідентифікатор контакту"
          }
        }
      ],
      "get": {
        "operationId": "getContactById",
        "summary": "Отримати контакт за ID",
        "tags": [
          "contacts"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Контакт знайдено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contact with id {contactId}!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Contact"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/error_response"
          },
          "404": {
            "$ref": "#/components/responses/error_response"
          }
        }
      },
      "patch": {
        "operationId": "updateContactById",
        "summary": "Оновити контакт за ID",
        "tags": [
          "contacts"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "phoneNumber": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "isFavourite": {
                    "type": "boolean"
                  },
                  "contactType": {
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ]
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Контакт оновлено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully patched a contact!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Contact"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/error_response"
          },
          "401": {
            "$ref": "#/components/responses/error_response"
          },
          "404": {
            "$ref": "#/components/responses/error_response"
          }
        }
      },
      "delete": {
        "operationId": "deleteContactById",
        "summary": "Видалити контакт за ID",
        "tags": [
          "contacts"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Контакт успішно видалено"
          },
          "401": {
            "$ref": "#/components/responses/error_response"
          },
          "404": {
            "$ref": "#/components/responses/error_response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Contact": {
        "type": "object",
        "required": [
          "name",
          "phoneNumber",
          "contactType",
          "userId"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "example": "64a9e1a8f4b8d9b1c1234568"
          },
          "name": {
            "type": "string",
            "example": "Jane Smith"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+380671234567"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.smith@example.com"
          },
          "isFavourite": {
            "type": "boolean",
            "example": false
          },
          "contactType": {
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ],
            "example": "personal"
          },
          "photo": {
            "type": "string",
            "format": "uri",
            "example": "https://res.cloudinary.com/yourimage.jpg"
          },
          "userId": {
            "type": "string",
            "example": "64a9e1a8f4b8d9b1c1234567"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "example": "64a9e1a8f4b8d9b1c1234567"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "userId",
          "accessToken",
          "refreshToken",
          "accessTokenValidUntil",
          "refreshTokenValidUntil"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "example": "64a9e1a8f4b8d9b1c1234567"
          },
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refreshToken": {
            "type": "string",
            "example": "dGhpc2lzYXJlZnJlc2h0b2tlbg=="
          },
          "accessTokenValidUntil": {
            "type": "string",
            "format": "date-time"
          },
          "refreshTokenValidUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "$ref": "#/components/schemas/error_response"
      },
      "error_response": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Bad Request"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        }
      }
    },
    "responses": {
      "SuccessResponse": {
        "$ref": "#/components/responses/success_response"
      },
      "ErrorResponse": {
        "$ref": "#/components/responses/error_response"
      },
      "success_response": {
        "description": "Успішна відповідь",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 200
                },
                "message": {
                  "type": "string",
                  "example": "Успішно виконано"
                },
                "data": {
                  "type": "object",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "error_response": {
        "description": "Відповідь з помилкою",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/error_response"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}